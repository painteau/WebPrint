<?php
declare(strict_types=1);

$sf = $_SERVER['SCRIPT_FILENAME'] ?? null;
if (($sf && realpath(__FILE__) === realpath($sf)) || (basename($_SERVER['SCRIPT_NAME'] ?? '') === basename(__FILE__))) {
    http_response_code(404);
    exit;
}

// Configuration for printer and API
return [
    'printer_name'       => 'DeskJet_3630',
    'printers'           => ['DeskJet_3630'],
    'cups_server'        => 'localhost',
    'cups_port'          => 631,
    'api_token'          => 'CHANGE_ME_SECRET_TOKEN',
    'max_file_size_mb'   => 20,
    'allowed_mime_types' => [
        'application/pdf',
        'application/postscript',
        'image/jpeg',
        'image/png',
        'image/tiff',
        'text/plain',
        'image/pwg-raster',
        'image/urf',
    ],
    // Plain text or bcrypt hash (php -r "echo password_hash('monmdp', PASSWORD_BCRYPT);")
    'index_password'     => '',
    // Network scanners (eSCL/AirScan) — name => base URL, no USB/device passthrough needed
    'scanners'           => [
        'DeskJet_3630' => 'http://192.168.1.50/eSCL',
    ],
];
