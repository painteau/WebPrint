DirectoryIndex index.php
Options -Indexes -MultiViews
RewriteEngine On
RewriteRule ^app/ - [F]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

<Files "config.php">
  Require all denied
  Satisfy All
</Files>
<Files "PrinterService.php">
  Require all denied
  Satisfy All
</Files>
<Files "ConfigLoader.php">
  Require all denied
  Satisfy All
</Files>
<Files "UploadHandler.php">
  Require all denied
  Satisfy All
</Files>

<Files "JobStore.php">
  Require all denied
  Satisfy All
</Files>

<Files "RateLimiter.php">
  Require all denied
  Satisfy All
</Files>

<Files "ScanService.php">
  Require all denied
  Satisfy All
</Files>

<Files "scan-worker.php">
  Require all denied
  Satisfy All
</Files>
